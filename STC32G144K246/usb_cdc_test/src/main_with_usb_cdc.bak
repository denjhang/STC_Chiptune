/*---------------------------------------------------------------------*/
/* --- STC MCU Limited ------------------------------------------------*/
/*---------------------------------------------------------------------*/

/*************  功能说明  **************

基于 STC88 官方 USB-CDC 双串口参考, 增加:
  1. P2 流水灯 (8 个 LED, 共阳)
  2. PWMB CH1 -> P0.0 方波输出 (硬件 PWM)
  3. Timer0 ISR (1ms) 驱动: 流水灯节拍 + CCR5 占空比切换
  4. USB CDC 双串口枚举 + 串口2/3 透传 (与 PWMB/Timer0 共存)

主频: 24MHz IRC (无 PLL, USB 走独立 IRC48M)

******************************************/

#include "stc.h"
#include "usb.h"
#include "uart.h"
#include "timer.h"

unsigned long MAIN_Fosc = 24000000L;

/* ========== LED 流水灯 (P2 整组, 共阳 0=亮) ========== */
u8  led_val = 0xFE;     /* P2.0 亮 */
u8  led_dir = 0;        /* 0=左移, 1=右移 */

/* ========== PWMB CH1 -> P0.0 方波 ========== */
#define PWMB_ENO1P    0x01
#define PWMB_CCMR5_VAL 0x68
#define PWMB_CCER5_VAL 0x05

/* CCR 切换序列, 每 200ms 切一次 */
static u16 duty_ms_cnt = 0;
static u8  duty_idx = 0;
static const u8 duty_table[3] = {128, 64, 192};  /* 50% -> 25% -> 75% */

void pwmb_square_init(void)
{
    PWMB_ENO   = 0x00;
    PWMB_CCER1 = 0x00;
    PWMB_CCMR1 = PWMB_CCMR5_VAL;
    PWMB_CCER1 = PWMB_CCER5_VAL;
    PWMB_ARRH  = 0x00;
    PWMB_ARRL  = 255;
    PWMB_CCR5H = 0x00;
    PWMB_CCR5L = duty_table[0];
    PWMB_PSCRH = 0x00;
    PWMB_PSCRL = 0x00;
    PWMB_PS = (PWMB_PS & ~0x03) | 0x02;  /* PS=2 -> P0.0 */
    PWMB_ENO = PWMB_ENO1P;
    PWMB_BKR = 0x80;
    PWMB_CR1 = 0x01;
}

void sys_init(void);

void main(void)
{
    sys_init();
    uart_init();
    pwmb_square_init();
    timer_init();
    usb_init();
    EA = 1;

    while (1)
    {
        uart_polling();
        /* 诊断模式: 只跑 USB CDC + PWMB 静态方波, 不动 CCR/流水灯 */
    }
}

void sys_init(void)
{
    WTST = 0;
    EAXFR = 1;
    CKCON = 0;

    P0M1 = 0x00;   P0M0 = 0x00;   /* 全部准双向 (主项目验证 PWMB 在准双向下工作) */
    P1M1 = 0x00;   P1M0 = 0x00;
    P2M1 = 0x00;   P2M0 = 0x00;   /* P2 = 8 个 LED */
    P3M1 = 0x00;   P3M0 = 0x00;   /* P3.0/P3.1 = USB D-/D+ */
    P4M1 = 0x00;   P4M0 = 0x00;
    P5M1 = 0x00;   P5M0 = 0x00;
    P6M1 = 0x00;   P6M0 = 0x00;
    P7M1 = 0x00;   P7M0 = 0x00;

    S3_S = 1;       /* UART3 (P5.0/P5.1) - CDC1 */
    S2_S = 1;       /* UART2 (P4.6/P4.7) - CDC2 */

    P2 = 0xFF;      /* 全灭 (共阳) */
}

#define SVCC_ON()           SVCC_E = 0; P5M1 &= ~0x03
#define SVCC_OFF()          SVCC_E = 1; P5M1 |= 0x03
